# Secrets and local configuration: never commit these.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
local.settings.json

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# Logs and temporary files
*.log
tmp/
temp/

# Add language-specific entries below, for example from
# https://github.com/github/gitignore

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
/build/
/dist/
.pytest_cache/

# Site build output
/site/

# UI test tooling
node_modules/
test-results/
playwright-report/
